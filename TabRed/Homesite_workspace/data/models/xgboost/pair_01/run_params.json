{
  "model_type": "xgboost",
  "seed_base": 42,
  "window_parameters": {
    "L": 8,
    "S": 5,
    "H": 3,
    "R": 8,
    "K_FRAC": 0.1,
    "PAIR_STRIDE": 4
  },
  "cv_n_splits": 3,
  "cat_min_freq": 0.01,
  "cat_unk_value": -1,
  "encoder_scope": "per_window_side_shared",
  "class_weighting": {
    "enabled": true,
    "scheme": "balanced_sample_weights",
    "formula": "w_pos = n / (2 * n_pos); w_neg = n / (2 * n_neg)",
    "clipped": false,
    "evaluation_pr_auc_weighted": false,
    "replica_data_scope": "training_core_before_early_stopping_tail",
    "tuning_data_scope": "fold_training_only",
    "lr_full_window_data_scope": null
  },
  "n_trials_xgboost": 25,
  "es_rounds": 50,
  "max_boost_round": 2000,
  "val_tail_frac": 0.15,
  "xgb_fixed": {
    "tree_method": "hist",
    "device": "cuda",
    "eval_metric": "aucpr",
    "verbosity": 0,
    "n_jobs": -1,
    "objective": "binary:logistic"
  },
  "xgb_cat_encoding": "one_hot_per_window_l2_threshold"
}